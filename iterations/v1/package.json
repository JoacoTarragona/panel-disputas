    "react": "~18.3.1",
    "react-dom": "~18.3.1"
  },
  "devDependencies": {
    "@types/react": "~18.3.18",
    "@types/react-dom": "~18.3.5",
    "@vitejs/plugin-react": "~4.3.4",
    "typescript": "~5.6.3",
    "vite": "~5.4.11",
    "vitest": "~2.1.8"
  },
  "optionalDependencies": {
    "playwright": "^1.49.1"
  }
}
